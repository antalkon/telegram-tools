# Password for the web panel
TGT_ADMIN_PASSWORD=change-me
# Long random string: signs login tokens and encrypts stored Telegram sessions.
# Changing it invalidates all connected accounts. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
TGT_SECRET_KEY=
# Set to true when the panel is served over HTTPS
TGT_COOKIE_SECURE=false
